#!/usr/bin/env just --justfile

set shell := ["bash", "-euo", "pipefail", "-c"]

import "../.justfiles/tool.justfile"

# region Tools

[doc('Check if Docker runtime is running')]
[private]
@tool-docker-runtime: (tool "docker")
	if ! docker info >/dev/null 2>&1; then \
		echo 'Docker runtime is not active. Start Docker runtime'; \
		exit 1; \
	fi;

# endregion Tools

[doc('Lint the startup script with ShellCheck and Dockerfile with Hadolint')]
lint: (tool "shellcheck") (tool "hadolint")
	bash -n nfsd.sh
	shellcheck nfsd.sh
	hadolint Dockerfile

[doc('Check the Dockerfile without building an image')]
test: tool-docker-runtime
	docker build --check .

[doc('Build the image locally')]
build: tool-docker-runtime
	docker build --tag nfsd:local .
