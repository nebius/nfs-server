#!/usr/bin/env just --justfile

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
@_tool name:
	if ! command -v {{ name }} >/dev/null 2>&1; then \
		echo '{{ name }} is missing. Install {{ if name == "cr" { "chart-releaser" } else { name } }} with your package manager.'; \
		exit 1; \
	fi

[doc("Format Python scripts")]
@fmt: (_tool "black")
	black --workers 1 .

[doc("Lint Python scripts")]
@lint: (_tool "black") (_tool "mypy")
	black --check --workers 1 .
	mypy --config-file ../pyproject.toml .

[doc("Test release scripts without external publication")]
@test: (_tool "python3") (_tool "pytest") (_tool "changie") (_tool "docker") (_tool "helm") (_tool "jq")
	pytest .
