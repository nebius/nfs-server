#!/usr/bin/env just --justfile

set shell := ["bash", "-euo", "pipefail", "-c"]

import "../jf.tool.justfile"

[doc("Format Python scripts")]
@fmt: (tool "black")
	black --workers 1 .

[doc("Lint Python scripts")]
@lint: (tool "black") (tool "mypy")
	black --check --workers 1 .
	mypy --config-file ../pyproject.toml .

[doc("Test release scripts without external publication")]
@test: (tool "python3") (tool "pytest") (tool "changie") (tool "docker") (tool "helm") (tool "jq")
	pytest .
